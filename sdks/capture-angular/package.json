{
  "name": "@crikket-io/capture-angular",
  "version": "0.1.0",
  "description": "Angular integration for the Crikket browser capture SDK. Provides provideCrikket(), CrikketModule and an injectable CrikketService that lazy-loads @crikket-io/capture (SSR-safe).",
  "license": "AGPL-3.0-only",
  "homepage": "https://crikket.io/docs",
  "bugs": {
    "url": "https://github.com/redpangilinan/crikket/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redpangilinan/crikket.git",
    "directory": "sdks/capture-angular"
  },
  "keywords": [
    "angular",
    "bug-reporting",
    "capture-sdk",
    "crikket",
    "feedback-widget",
    "screen-recording",
    "screenshot"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "prepack": "bun run build",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@angular/common": ">=16.0.0 <21.0.0",
    "@angular/core": ">=16.0.0 <21.0.0",
    "@crikket-io/capture": ">=0.1.1",
    "react": ">=18",
    "react-dom": ">=18",
    "rxjs": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@crikket-io/capture": "workspace:*",
    "ng-packagr": "^18.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "typescript": "~5.5.4",
    "zone.js": "^0.14.10"
  }
}
